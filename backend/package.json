{
  "name": "physics-portal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --env-file=../.env run src/main.ts",
    "dev": "bun --env-file=../.env --watch run src/main.ts",
    "build": "bun run tsc --noEmit -p tsconfig.build.json",
    "typecheck": "bun run tsc --noEmit -p tsconfig.json",
    "test": "bun --env-file=../.env test",
    "migration:run": "bun --env-file=../.env run src/database/migrate.ts",
    "seed:teacher": "bun --env-file=../.env run src/database/seed-teacher.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.5.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
